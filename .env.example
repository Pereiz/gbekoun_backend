# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env n'est jamais versionné.

# ---------- Application ----------
# 1 = développement (secrets de secours autorisés, logs détaillés). 0 en production.
FLASK_DEBUG=1
PORT=8880
# Obligatoires en production. Générer avec :  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET=
JWT_EXPIRATION_DAYS=30

# ---------- PostgreSQL ----------
# Lancement via docker-compose : PG_HOST est forcé à "postgres" automatiquement.
# Lancement local (python app.py) avec la base docker : localhost / 5435.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# ---------- MongoDB ----------
# Lancement local (python app.py) avec la base docker :
MONGO_URI=
MONGO_DB=
# Utilisés par docker-compose pour créer le compte root du conteneur Mongo
# (doivent correspondre à l'utilisateur/mot de passe de MONGO_URI ci-dessus).
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGER_MOI

# ---------- Interface d'administration web ----------
# Sites autorisés à appeler l'API depuis un navigateur (séparés par des virgules).
# Vide en développement = localhost:3000, 5173 et 8081 autorisés.
# En production, mettre le vrai domaine de l'interface admin, par exemple :
#   CORS_ORIGINS=https://admin.gbekoun.example
CORS_ORIGINS=

# ---------- Notifications push (optionnel) ----------
EXPO_ACCESS_TOKEN=

# ---------- Sauvegardes (optionnel) ----------
BACKUP_DIR=backups
