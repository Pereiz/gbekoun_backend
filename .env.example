# .env.example - Copiez ce fichier en .env et adaptez les valeurs

# Flask
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
FLASK_ENV=development
FLASK_DEBUG=1

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=gbekoundb
PG_USER=gbekoundb_user
PG_PASSWORD=your-password-here

# MongoDB
MONGO_URI=mongodb://localhost:27017/gbekoundb_messages
MONGO_DB=gbekoundb_messages

# Uploads
UPLOAD_FOLDER=uploads