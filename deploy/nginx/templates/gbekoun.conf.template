# =============================================================
# GBEKOUN - Nginx (production)
# ${API_DOMAIN} est remplacé au démarrage du conteneur (variable d'environnement).
# Les variables Nginx ($host, $remote_addr…) ne sont pas touchées.
# =============================================================

# ---------- Limitation de débit (par adresse IP) ----------
# Réglages volontairement larges : beaucoup d'abonnés mobiles partagent la même
# IP publique chez leur opérateur (CGNAT). Ajuster si des utilisateurs légitimes
# reçoivent des 429.
limit_req_zone $binary_remote_addr zone=gbekoun_auth:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=gbekoun_api:10m  rate=20r/s;
limit_req_status 429;
# Dépassements de quota journalisés en avertissement (et non en erreur) :
# les vraies erreurs restent visibles dans les logs.
limit_req_log_level warn;
limit_conn_log_level warn;
limit_conn_zone $binary_remote_addr zone=gbekoun_conn:10m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream gbekoun_api {
    server api:8880;
}

# ---------- Requêtes qui ne visent pas le domaine (scan par IP, faux Host) ----------
# Connexion coupée sans réponse ; en HTTPS, la négociation TLS est refusée.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

# ---------- HTTP : validation Let's Encrypt + redirection vers HTTPS ----------
server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:gbekoun_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # En-têtes de sécurité
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Photos de profil : 2 Mo max côté API ; marge pour l'enveloppe multipart.
    client_max_body_size 10m;
    limit_conn gbekoun_conn 50;

    gzip on;
    gzip_types application/json text/plain;
    gzip_min_length 1024;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    # Temps réel (Socket.IO) : WebSocket + long-polling, connexions longues
    location /socket.io/ {
        proxy_pass http://gbekoun_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Attente de validation d'un appareil : interrogée toutes les 2-3 s,
    # ne doit pas consommer le quota strict de l'authentification.
    location ~ ^/api/auth/device/requests/[^/]+/status$ {
        limit_req zone=gbekoun_api burst=60 nodelay;
        proxy_pass http://gbekoun_api;
    }

    # Authentification (connexion, inscription, activation) : quota strict
    # contre les essais en masse (numéros, codes d'activation).
    location /api/auth/ {
        limit_req zone=gbekoun_auth burst=20 nodelay;
        proxy_pass http://gbekoun_api;
    }

    # Documentation Swagger : désactivée en production (disponible en dev).
    # Pour l'ouvrir à une adresse précise : remplacer « return 404; » par
    #   allow 203.0.113.10; deny all; proxy_pass http://gbekoun_api;
    location ~ ^/(apidocs|apispec\.json|flasgger_static|oauth2-redirect\.html) {
        return 404;
    }

    location / {
        limit_req zone=gbekoun_api burst=60 nodelay;
        proxy_pass http://gbekoun_api;
    }
}
